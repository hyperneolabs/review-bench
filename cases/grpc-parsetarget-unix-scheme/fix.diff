+func TestParseTargetString(t *testing.T) {
+	for _, test := range []struct {
+		targetStr string
+		want      resolver.Target
+	}{
+		{"", resolver.Target{"", "", ""}},
+		{"://", resolver.Target{"", "", ""}},
+		{":///", resolver.Target{"", "", ""}},
